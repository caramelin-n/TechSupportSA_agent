POSTGRES_USER=techsupport
POSTGRES_PASSWORD=techsupport
POSTGRES_DB=techsupport
DATABASE_URL=postgresql+psycopg://techsupport:techsupport@localhost:5432/techsupport
SECRET_KEY=change-me-in-production-at-least-16-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Google AI Studio: https://aistudio.google.com/apikey
# Sin esta key el CRUD sigue funcionando; el agente y los embeddings fallan.
GOOGLE_API_KEY=
# Modelo de chat del agente. Los gemini-2.5 no están disponibles para claves
# nuevas. Alternativa más capaz: gemini-3.8-flash (menos requests gratis).
# Límites de tu clave: https://aistudio.google.com/rate-limit
LLM_MODEL=gemini-3.5-flash-lite
# Detección de tickets duplicados (embeddings de 1536 dimensiones).
EMBEDDING_MODEL=gemini-embedding-001
# Distancia coseno máxima para considerar dos tickets la misma incidencia.
# Calibrala con: python scripts/indexar_tickets.py --calibrar
DUPLICATE_MAX_DISTANCE=0.14
