# Base URL del backend. Vite solo expone variables con prefijo VITE_.
# El prefijo /api lo corta el proxy de Vite (dev) y nginx (docker).
VITE_API_BASE=/api

# Host del backend para el dev server de Vite.
# En Docker es "backend" (nombre del servicio); si corrés `npm run dev` en el
# host, usá VITE_PROXY_TARGET=localhost.
VITE_PROXY_TARGET=backend
